# Contoh Konfigurasi Lingkungan (Environment Variables)
# Salin file ini menjadi .env dan isi nilainya secara lokal.
# JANGAN pernah meng-commit file .env asli ke Git repository.

# Application Configuration
PORT=8000
NODE_ENV=development

# Model & LLM Settings
ACTIVE_MODEL=gemma4:31b-cloud
NUM_CTX=32000

# Optional API Keys / Endpoint URLs (jika ada)
# GEMINI_API_KEY=your_api_key_here
# OPENAI_API_KEY=your_api_key_here
