# Contoh Konfigurasi Lingkungan (Environment Variables)
# Salin file ini menjadi .env dan isi nilainya secara lokal.
# JANGAN pernah meng-commit file .env asli ke Git repository.

# Application Configuration
PORT=8000
NODE_ENV=development

# Model & LLM Settings
ACTIVE_MODEL=qwen2.5:7b
TEMPERATURE=0.3
TOP_P=0.85
NUM_CTX=32000

# Web Search API (PILIH SALAH SATU):
# 1. Serper.dev (Sangat direkomendasikan - Google Search Asli untuk AI, 2.500 kueri gratis tanpa kartu kredit di https://serper.dev)
# SERPER_API_KEY=your_serper_api_key_here

# 2. Tavily AI Search (Mesin pencari khusus AI agent, 1.000 kueri gratis/bulan di https://tavily.com)
# TAVILY_API_KEY=your_tavily_api_key_here

# 3. Google Custom Search API Lama (Hanya untuk akun sebelum 2024 yang sudah punya CX)
# GOOGLE_SEARCH_API_KEY=your_google_api_key_here
# GOOGLE_SEARCH_CX=your_custom_search_engine_id_here
